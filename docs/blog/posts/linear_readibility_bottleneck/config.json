{
  "dataset": "mnist",
  "data_root": "/content/data",
  "out_dir": "/content/runs/linsep_heads_mnist_v4",
  "seed": 43,
  "epochs": 20,
  "batch_size": 256,
  "eval_batch_size": 512,
  "lr": 0.001,
  "min_lr_ratio": 0.05,
  "warmup_epochs": 0,
  "weight_decay": 0.05,
  "label_smoothing": 0.05,
  "use_amp": true,
  "grad_clip_norm": 1.0,
  "num_workers": 2,
  "img_size": 32,
  "patch_size": 4,
  "embed_dim": 64,
  "num_layers": 4,
  "num_heads": 4,
  "mlp_ratio": 4,
  "dropout": 0.1,
  "train_subset": -1,
  "test_subset": -1,
  "save_epochs": "0,1,2,5,10,20",
  "probe_train_samples": 10000,
  "probe_test_samples": 10000,
  "bootstrap_samples": 1000,
  "include_rbf_svm": true,
  "include_mlp": true,
  "include_rf": true,
  "include_knn": true,
  "include_gp": false,
  "gp_train_samples": 800,
  "rf_trees": 300,
  "enable_conformal": true,
  "conformal_alpha": 0.1,
  "conformal_fit_fraction": 0.6,
  "conformal_selection_fraction": 0.2,
  "conformal_calib_fraction": 0.2,
  "save_conformal_examples": true,
  "conformal_score": "rank",
  "conformal_calibration_source": "holdout",
  "conformal_holdout_calib_fraction": 0.5,
  "coverage_tolerance": 0.01,
  "posthoc_only": false
}